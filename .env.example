# ─── REVOLVYN Owner CMS — environment template ─────────────────────────────
# Copy to .env (local) and set the same keys in Vercel → Project → Settings →
# Environment Variables. NEVER commit a real .env file.

# ── Clerk (https://dashboard.clerk.com) ─────────────────────────────────────
# Publishable key is PUBLIC and safe for the browser (used by /manage).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret key is SERVER-ONLY. Never expose in client-side code.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Neon PostgreSQL (https://console.neon.tech) ─────────────────────────────
# Pooled connection string. Server-side only (used by /api/* and scripts).
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Cloudinary — media uploads (https://console.cloudinary.com) ─────────────
# Optional but recommended. If unset, the CMS still works: owners can paste
# image/video links, but direct file uploads are disabled with a friendly note.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── CMS bootstrap ───────────────────────────────────────────────────────────
# Clerk user ID of the first owner (find it in Clerk Dashboard → Users → click
# the owner → User ID, starts with "user_..."). Used by:
#   npm run cms:create-owner -- --clerk-id=user_xxx --email=owner@example.com
CMS_FIRST_OWNER_CLERK_ID=
CMS_FIRST_OWNER_EMAIL=
